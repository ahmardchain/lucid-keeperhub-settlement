# Lucid exact x402 settlement target. This must be the wallet KeeperHub controls.
PAYMENTS_RECEIVABLE_ADDRESS=0x0000000000000000000000000000000000000000

# KeeperHub organization key with mcp:read + mcp:write (or admin) scope.
KEEPERHUB_API_KEY=kh_replace_me
KEEPERHUB_API_BASE_URL=https://app.keeperhub.com

# x402 facilitator and a Base Sepolia JSON-RPC endpoint.
FACILITATOR_URL=https://replace-with-your-facilitator.example
BASE_SEPOLIA_RPC_URL=https://replace-with-your-base-sepolia-rpc.example

# Circle USDC on Base Sepolia; override only if the paid offer uses another deployment.
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# 0.01 USDC in 6-decimal atomic units, and a one-minute fulfillment deadline.
TASK_PRICE_ATOMIC=10000
TASK_DEADLINE_MS=60000

DATABASE_PATH=.data/settlement.db
PORT=8788

# Live proof runner. Never commit the buyer key or a populated .env file.
AGENT_URL=http://localhost:8788/api/agent
SETTLEMENT_API_URL=http://localhost:8788/api/settlements
BUYER_PRIVATE_KEY=0xreplace_me
WORKER_PAYOUT_ADDRESS=0x0000000000000000000000000000000000000000
DEMO_SUCCESS_TX_HASH=0xreplace_with_a_successful_base_sepolia_transaction
DEMO_RUNS_PER_PATH=1
